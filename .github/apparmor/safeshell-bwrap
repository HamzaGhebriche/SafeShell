# Disposable CI/VM test-host setup. Keep the global user-namespace restriction.
# Parent permissions authorize trusted bwrap to assemble its namespaces; the
# stacked exec profile removes capabilities/user namespaces from guest programs.
abi <abi/4.0>,
include <tunables/global>

# Enforce mode is intentional: the hosted kernel retained the default_allow
# setup domain across exec. Explicit permissions replace implicit allow all.
# Stacking adds the child restrictions without removing the original domain,
# preserving no-new-privileges (which correctly rejects replacement transitions).
# The trusted namespace assembler needs disconnected-path lookup while it
# replaces its mount namespace. File access in this setup domain is path-wide.
profile safeshell-bwrap /usr/bin/bwrap flags=(attach_disconnected) {
  / r,
  /** mrwkl,
  network netlink raw,
  # libc if_nametoindex uses this socket for bwrap's loopback lookup.
  network unix dgram,
  signal,
  ptrace (read, readby) peer={safeshell-bwrap,safeshell-bwrap//&safeshell-child},
  mount,
  umount,
  pivot_root,
  userns,
  capability,
  /** px -> safeshell-bwrap//&safeshell-child,
}

# Inherited /dev/null and output pipes are disconnected from the guest mount
# tree. Permit metadata lookup under a distinct synthetic prefix, avoiding
# aliasing to real guest paths. Sensitive FD exclusion is tested by inode identity.
# AppArmor file permissions are not the filesystem boundary: explicit bwrap
# mounts supply that boundary; this profile denies capabilities/user namespaces.
profile safeshell-child flags=(attach_disconnected, attach_disconnected.path=/safeshell-disconnected) {
  / r,
  /** mrwkl,
  signal,
  ptrace (read, readby) peer=safeshell-bwrap//&safeshell-child,
  audit deny capability,
  deny userns,
  /** ix,
}
