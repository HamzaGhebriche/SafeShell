# CI host setup only. Do not disable AppArmor's global user-namespace restriction.
# Parent permissions authorize trusted bwrap to assemble its namespaces; the exec
# transition removes capabilities/user namespaces from every sandbox program.
abi <abi/4.0>,
include <tunables/global>

# Enforce mode is intentional: the hosted kernel retained the default_allow
# setup domain across exec. These explicit permissions replace implicit allow
# all with the operations bwrap needs; child programs cannot retain this domain.
profile safeshell-bwrap /usr/bin/bwrap {
  /** mrwkl,
  network netlink raw,
  signal,
  mount,
  umount,
  pivot_root,
  userns,
  capability,
  /** px -> safeshell-child,
}

profile safeshell-child {
  /** mrwkl,
  signal,
  ptrace (read) peer=safeshell-child,
  audit deny capability,
  deny userns,
  /** ix,
}
